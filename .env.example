# ============================================================
# Platinvent — Environment Variables Template (.env.example)
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo a `.env` o `.env.local`
#   2. Completa los valores de tu entorno de desarrollo o producción
# ============================================================

# OpenTraxx API
OPENTRAXX_URL=https://opentraxx.cl
# OPENTRAXX_TIMEOUT_MS=15000

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=platinvent_db

# Web Push VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Modo de datos ("local" para JSON local, "remote" para API/MySQL)
DATA_MODE=local
