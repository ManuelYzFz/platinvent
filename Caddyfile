# Bloque 1: dominio público con SSL automático (para pruebas externas con no-ip y puertos abiertos)
inventariadovtraxx.freedynamicdns.org {
    reverse_proxy app:3000 {
        transport http {
            versions 1.1
        }
    }
}

# Bloque 2: Acceso local para tu sin tocar puertos ni no-ip, solo para pruebas locales
localhost {
    reverse_proxy app:3000 {
        transport http {
            versions 1.1
        }
    }
}